# Copy to .env and fill in values. After that, run neurosync; if Spotify OAuth
# is not cached yet, a browser window will open for authorization.

# --- Required (must be non-empty; app exits if any are missing) ---
# AWEar/MindfulMakers: real API host (replace example.com — check docs or welcome email)
AWEAR_BASE_URL=https://awear-b2b-2026.vercel.app/api/v1
AWEAR_API_KEY=awr_sk_3d82e37747d7ba6ded5113287e7c67557623c0ca6c35b460837d64d858669210
AWEAR_MEMBER_EMAIL=emilyjolam@gmail.com

# Spotify app: https://developer.spotify.com/dashboard — register redirect URI below
SPOTIFY_CLIENT_ID=884157f7eb4148e9a0ab6329f99aeb4c
SPOTIFY_CLIENT_SECRET=470a46de8df44ec19a53f05505431cb4
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_TOKEN_CACHE=.spotify_token_cache

# Desktop app: right-click playlist → Share → Copy Spotify URI (spotify:playlist:...)
SPOTIFY_PLAYLIST_FOCUS=spotify:playlist:37i9dQZF1DWWQRwui0ExPn
SPOTIFY_PLAYLIST_CALM=spotify:playlist:37i9dQZF1DWV1PBrIG2weG

# --- Optional ---
# Uncomment if Spotify does not auto-pick the right device (substring match on name)
# SPOTIFY_DEVICE_NAME=MacBook

# --- Defaults (fine to leave as-is; tune EEG heuristics after you see how it feels) ---
AWEAR_FETCH_MINUTES=60
AWEAR_SAMPLING_HZ=256
POLL_SECONDS=6

STRESS_BETA_ALPHA_RATIO=2.2
FOCUS_BETA_ALPHA_RATIO=1.35
STATE_MIN_EPOCHS=2
STATE_SMOOTH_WINDOW=5
STATE_CONFIRM_TICKS=3
